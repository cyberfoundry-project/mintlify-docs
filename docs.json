{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "CyberFoundry",
  "description": "Documentation",
  "colors": {
    "primary": "#166E3F",
    "light": "#26BD6C",
    "dark": "#166E3F"
  },
  "favicon": "/favicon.ico",
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "system"
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Home",
          "icon": "house",
          "href": "/"
        }
      ]
    },
    "directory": "card",
    "products": [
      {
        "product": "Test",
        "groups": [
          {
            "group": "Platform",
            "icon": "layers",
            "expanded": true,
            "pages": [
              "platform/quickstart",
              "platform/key-concepts",
              "platform/configuration/settings",
              "platform/configuration/user-management",
              "platform/administration/roles-permissions"
            ]
          },
          {
            "group": "Analytics",
            "icon": "chart-bar",
            "expanded": true,
            "pages": [
              "analytics/quickstart",
              "analytics/connect-data",
              "analytics/dashboards/create-dashboard",
              "analytics/reports/scheduled-reports"
            ]
          },
          {
            "group": "Integrations",
            "icon": "plug",
            "expanded": true,
            "pages": [
              "integrations/quickstart",
              "integrations/authentication",
              "integrations/connectors/crm",
              "integrations/webhooks/configure"
            ]
          }
        ]
      },
      {
        "product": "Community Tools",
        "pages": [
          "overview"
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://cyberfoundry.tech"
  },
  "navbar": {
    "links": [
      {
        "href": "https://cyberfoundry.tech",
        "label": "cyberfoundry.tech"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dashboard.mintlify.com"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/cyberfoundry-project",
      "website": "https://cyberfoundry.tech"
    }
  },
  "banner": {
    "content": "ALPHA STAGE -- THIS SITE IS CURRENTLY UNDER HEAVY UPDATES",
    "type": "info"
  },
  "fonts": {
    "heading": {
      "family": "Geist"
    },
    "body": {
      "family": "Inter"
    }
  }
}
